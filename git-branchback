#!/usr/bin/env python3
"""Preview one wrong-branch commit recovery using local Git evidence."""
import argparse
import os
import re
import subprocess
import sys


class Blocked(Exception):
    pass


def git(*args):
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0", GIT_NO_LAZY_FETCH="1")
    result = subprocess.run(["git", *args], capture_output=True, env=env)
    if result.returncode:
        raise Blocked("Git could not verify " + args[0] + ".")
    return result.stdout


def preview(target, count):
    if git("rev-parse", "--is-inside-work-tree").strip() != b"true":
        raise Blocked("Open a repository working tree.")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_./-]*", target):
        raise Blocked("Use a plain branch name.")
    git("check-ref-format", "--branch", target)
    full = "refs/heads/" + target
    refs = git("for-each-ref", "--format=%(refname)", "refs/heads").decode().splitlines()
    if any(full == r or full.startswith(r + "/") or r.startswith(full + "/") for r in refs):
        raise Blocked("Choose an available new branch name.")
    source = git("symbolic-ref", "--short", "HEAD").decode().strip()
    for marker in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge",
                   "rebase-apply", "sequencer", "BISECT_START"):
        if os.path.exists(os.fsdecode(git("rev-parse", "--git-path", marker).rstrip(b"\n"))):
            raise Blocked("Finish the current Git operation first.")
    history = git("rev-list", "--first-parent", "--parents", "-n", str(count), "HEAD")
    commits = [line.split() for line in history.decode().splitlines()]
    if len(commits) != count or any(len(row) != 2 for row in commits):
        raise Blocked("Each selected commit must have exactly one visible parent.")
    tip = commits[0][0]
    oldest, parent = commits[-1]
    # Every selected commit descends from the oldest one.
    if git("for-each-ref", "--contains", oldest, "--format=%(refname)", "refs/remotes").strip():
        raise Blocked("A known remote-tracking branch contains a selected commit.")
    status = git("status", "--porcelain=v1", "-z", "--no-renames",
                 "--untracked-files=all", "--ignore-submodules=none").split(b"\0")
    codes = [entry[:2] for entry in status if entry]
    if any(c in (b"DD", b"AU", b"UD", b"UA", b"DU", b"AA", b"UU") for c in codes):
        raise Blocked("Resolve conflicted paths first.")
    print(f"Preview only\nNew branch {target} would point to {tip}.")
    if count > 1:
        print(f"Selected {count} consecutive commits, oldest first:")
        for commit, _ in reversed(commits):
            print(commit)
    print(f"Switching there at the same commit would retain your index and working files.")
    print(f"Then {source} would move back to {parent}.")
    print("Current paths: {} staged, {} unstaged, {} untracked.".format(
        sum(c[:1] not in (b" ", b"?") for c in codes),
        sum(c[1:] not in (b" ", b"?") for c in codes), codes.count(b"??")))
    print("Remote evidence is local and may be stale. Confirm the commit is private.")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("new_branch")
    parser.add_argument("--commits", type=int, default=1, metavar="N",
                        help="preview the latest N consecutive single-parent commits (default: 1)")
    args = parser.parse_args()
    if args.commits < 1 or args.commits > 2147483647:
        parser.error("--commits must be between 1 and 2147483647")
    try:
        preview(args.new_branch, args.commits)
    except (Blocked, OSError, UnicodeError) as error:
        sys.exit("Preview unavailable: " + str(error))
